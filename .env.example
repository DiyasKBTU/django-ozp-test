# Осы файлды .env деп көшіріп, мәндерін толтырыңыз. .env git-ке қосылмайды.

# Құпия кілт. Серверде міндетті түрде жаңа кездейсоқ мән қойыңыз:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Жергілікті әзірлеуде True, серверде False
DEBUG=True

# Сайт ашылатын домендер (үтір арқылы)
ALLOWED_HOSTS=localhost,127.0.0.1

# Бос болса — жергілікті SQLite (db.sqlite3).
# Серверде: postgres://ПАЙДАЛАНУШЫ:ҚҰПИЯ_СӨЗ@localhost:5432/БАЗА_АТАУЫ
DATABASE_URL=

# Тек серверде (міндетті емес):
# Формалар жіберілетін домендер, мысалы https://pbbtest.oaiu.kz
CSRF_TRUSTED_ORIGINS=
# HTTPS дұрыс жұмыс істейтініне көз жеткізгеннен кейін: 31536000 (бір жыл)
SECURE_HSTS_SECONDS=0
